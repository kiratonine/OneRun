# Базовый URL бэкенда. Значение '/mock' (или отсутствие переменной) включает
# локальные фикстуры — приложение работает целиком без бэкенда.
# Для стыковки: VITE_API_BASE_URL=https://<адрес-бэкенда>
VITE_API_BASE_URL=/mock

# Supabase Realtime: подписка на изменения в orders. Только anon-ключ —
# фронтенд не пишет в БД, вся логика в NestJS.
# Обе переменные пустые = подписки нет, живость данных обеспечивает опрос
# каждые POLL_INTERVAL_MS. На демо это неотличимо, так что заполнять не обязательно.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
